#!/usr/bin/env sh
#
# Fake gcloud for the test harness. Records every invocation to $GCLOUD_LOG,
# one shell-quoted line per call, and returns canned output so the scripts
# under test can run to completion without touching Google Cloud.
#
# Behaviour is steered by environment variables set by the test case:
#   MOCK_FAIL_CREATE=1     make "instances create" fail
#   MOCK_UNREACHABLE_HOST  name of one host whose "compute ssh" always fails,
#                          used to simulate a replacement that never boots
#   MOCK_LIVE_FAMILY=129   which cos-<n>-lts family resolves; others 404
#   MOCK_CURRENT_MILESTONE the value /etc/os-release reports on the old host

: "${GCLOUD_LOG:=/dev/null}"
: "${MOCK_LIVE_FAMILY:=129}"
: "${MOCK_CURRENT_MILESTONE:=109}"

printf '%s\n' "$*" >> "$GCLOUD_LOG"

case "$1 $2" in
"compute ssh")
	[ -n "${MOCK_UNREACHABLE_HOST:-}" ] && [ "$3" = "$MOCK_UNREACHABLE_HOST" ] && exit 255
	# The command being run on the VM is the argument after --command.
	CMD=""
	while [ $# -gt 0 ]; do
		[ "$1" = "--command" ] && { CMD="$2"; break; }
		shift
	done
	case "$CMD" in
	*"os-release"*)      printf '%s\n' "$MOCK_CURRENT_MILESTONE" ;;
	*"pwd"*)             printf '/home/tester/bitwarden_gcloud\n' ;;
	*"backups/*.aes256"*) printf '/mnt/disks/bwgc/bitwarden_gcloud/bitwarden/backups/bw_backup_2026-08-26-000000.tar.gz.aes256\n' ;;
	*"DOMAIN="*)         printf 'vault.example.test\n' ;;
	*"backup.sh"*)       printf 'INFO: Backup to local completed\nINFO: Backup to rclone completed\n' ;;
	*"BACKUP_VERIFIED"*|*"db.sqlite3"*) printf 'BACKUP_VERIFIED\n' ;;
	*"docker ps"*)       printf 'bitwarden\tUp 20 seconds (healthy)\nproxy\tUp 20 seconds\n' ;;
	*)                   printf 'ok\n' ;;
	esac
	exit 0
	;;
"compute images")
	case "$3" in
	describe-from-family)
		# $4 is cos-<n>-lts
		want="cos-${MOCK_LIVE_FAMILY}-lts"
		[ "$4" = "$want" ] && { printf '%s-19506-299-161\n' "$want"; exit 0; }
		echo "ERROR: family $4 not found" >&2
		exit 1
		;;
	esac
	exit 0
	;;
"compute instances")
	case "$3" in
	create) [ "${MOCK_FAIL_CREATE:-0}" = "1" ] && { echo "ERROR: ZONE_RESOURCE_POOL_EXHAUSTED" >&2; exit 1; } ;;
	describe) printf '\n' ;;
	esac
	exit 0
	;;
"compute disks")
	case "$3" in
	describe) [ "${MOCK_DISK_EXISTS:-0}" = "1" ] || exit 1 ;;
	esac
	exit 0
	;;
*) exit 0 ;;
esac
