### GLOBAL VARIABLES ###

# The fully-qualified domain name for Bitwarden - what address do you want Bitwarden accessible? 
# Do not include the protocol (http/https), that is added when needed in docker-compose.yml
# Used for caddy proxy and ddns with Cloudflare
DOMAIN=

# Timezone - used by some containers for logs / cron
# Find your location on this list and use the value in TZ Database Name, e.g Europe/Rome:
#   https://en.wikipedia.org/wiki/List_of_tz_database_time_zones
TZ=

# SMTP settings for Bitwarden and fail2ban 
# Uncomment and fill in details if you want to use e-mail invitations from bitwarden and e-mail alerts with fail2ban
# SMTP_SECURITY should be either starttls, force_tls, or off
# (see https://github.com/dani-garcia/vaultwarden/wiki/SMTP-Configuration)

#SMTP_HOST=
#SMTP_FROM=
#SMTP_PORT=
#SMTP_USERNAME=
#SMTP_PASSWORD=
#SMTP_SECURITY=
# Only read by the optional msmtpd container, which ships commented out in
# docker-compose.yml. Both settings typically needed if you enable it.
#SMTP_TLS=on        # Use TLS encryption for SMTP connection (default: off)
#SMTP_STARTTLS=on   # Use STARTTLS command before TLS negotiation (default: off)

### BITWARDEN VARIABLES ###

# Vaultwarden log level. "warn" logs failed logins and errors, which is what the
# fail2ban filters match. "info" adds a request/response pair for every HTTP
# call, which grows bitwarden/bitwarden.log fast and has no rotation. Raise it
# for debugging, then put it back.
#LOG_LEVEL=warn

# Setting up Bitwarden for the first time can be done in two ways:
# Uncomment the method you want to use / comment the one you don't
# Method 1. [RECOMMENDED] because it avoids the admin page entirely; using the admin
#   page overrides these environmental variables which can cause confusion.
#   1. Set up your primary account(s) while SIGNUPS_ALLOWED=true
#   2. Set SIGNUPS_ALLOWED=false
#   3. Set the SMTP details above to enable e-mail invitation
#   4. Invite other users from within Bitwarden
#   Keep ADMIN_TOKEN blank to disable access to the admin page entirely.
SIGNUPS_ALLOWED=true
ADMIN_TOKEN=
# Method 2. Use the admin page to create your first user(s) then disable it.
#   1. Set ADMIN_TOKEN using the command `openssl rand -base64 48`
#   2. Use the admin page (/admin) to create your initial user(s).
#   3. Disable the admin page by clearing the token (ADMIN_TOKEN=)
#SIGNUPS_ALLOWED=false
#ADMIN_TOKEN=
# Note on ADMIN_TOKEN: https://github.com/dani-garcia/vaultwarden/wiki/Enabling-admin-page#secure-the-admin_token

## Enables push notifications (requires key and id from https://bitwarden.com/host)
# PUSH_ENABLED=true
# PUSH_INSTALLATION_ID=
# PUSH_INSTALLATION_KEY=
## Don't change this unless you know what you're doing.
# PUSH_RELAY_BASE_URI=https://push.bitwarden.com

# Specify YUBIKEY info if desired
#YUBICO_CLIENT_ID=
#YUBICO_SECRET_KEY=
#YUBICO_SERVER=

# Specify which user email addresses can create organizations
# Leave blank to allow all users
ORG_CREATION_USERS=

# Bitwarden Backup Options
#
#
# GENERAL OPTIONS:
#
# How often to run the backup script; default is daily at midnight
BACKUP_SCHEDULE=0 0 * * *
# How many days of backups to keep
BACKUP_DAYS=30
# Directory to place backups in (& sync from in rclone)
BACKUP_DIR=/data/backups
# Optional - encryption key for backup
#   bitwarden data is encrypted at rest, but if your backup includes this env file <BACKUP_ENV=true>, your backup will include sensitive data
#BACKUP_ENCRYPTION_KEY="<key to encrypt backup>"
# Include .env in the backup archive.
#
# True, as shipped, makes the archive a complete restore point. False leaves the
# archive holding the vault database but not the settings needed to start the
# stack, so restoring onto a fresh deployment means writing .env by hand.
#
# .env holds your admin token, your SMTP password and, on the tunnel path, your
# tunnel token. With BACKUP_ENCRYPTION_KEY set the archive is encrypted and none
# of that is exposed. Without it the archive is a plain tar.gz containing all of
# them, and on BACKUP=email it is mailed to you daily.
#
# Both combinations are supported. The maintenance scripts report which one you
# have rather than insisting on either. Set the key above, or set this to false.
BACKUP_ENV=true
# Email address to send backup (BACKUP=email) or notifications (BACKUP_NOTIFY=true)
BACKUP_EMAIL_TO="<email to send the backup to>"
# Send email notification for rclone|local backup jobs
BACKUP_EMAIL_NOTIFY=true
#
#
# REQUIRED for any backup to run. Nothing above takes effect until this is set.
#
# Any combination of local|email|rclone, comma separated, no spaces. "local" is
# enough to start, and the maintenance scripts back up before they move or
# replace anything. Note that "local" keeps every copy on the same disk as the
# vault, so it does not survive losing that disk: add email or rclone for that.
# If you use rclone, follow the instructions below.
BACKUP=local
#
# RCLONE BACKUP OPTIONS:
#
# rclone first time run instructions:
#   1. Uncomment lines below and `docker-compose up -d`
#   2. With the backup container running, configure rclone with the following command:
#      `sudo docker exec -it backup ash -c 'rclone config --config $BACKUP_RCLONE_CONF'`
#   3. Follow the prompts and instructions at https://rclone.org/remote_setup/ - you 
#      will most likely need to download a rclone on another computer (it is portable)
#      to authorize.
#   4. The script should run as normal with a working configuration file
BACKUP_RCLONE_CONF=/data/rclone/rclone.conf
BACKUP_RCLONE_DEST=/bw_backup


### CONNECTIVITY: TUNNEL OR PROXY ###

# How the outside world reaches this vault. Pick one.
#
# Cloudflare Tunnel (default for new installs). cloudflared makes an outbound
# connection to Cloudflare, so this instance needs no open ports, no firewall
# rules, no certificate and no DNS record of its own. Set both lines:
#
#   COMPOSE_FILE=docker-compose.yml:docker-compose.tunnel.yml
#   TUNNEL_TOKEN=<output of: cloudflared tunnel token YOUR-TUNNEL-NAME>
#
# Setting COMPOSE_FILE is what selects the tunnel. Leave it unset and this
# deployment runs exactly as it always has, on Caddy -- an existing install that
# pulls this file changes nothing.
#
# Caddy (the original path, still supported). Leave both of the above unset and
# fill in EMAIL below. You will also need ports 80 and 443 open and a DNS record
# pointing at this instance.
#
#COMPOSE_FILE=docker-compose.yml:docker-compose.tunnel.yml
#TUNNEL_TOKEN=

### PROXY / CADDY VARIABLES ###

# EMAIL address to use with Let's Encrypt certificate provisioning.
#
# REQUIRED on the Caddy path, and ignored entirely on the Cloudflare Tunnel
# path, where TLS terminates at Cloudflare's edge and no certificate is issued
# here. The Caddyfile has "tls {$EMAIL}", and Caddy cannot parse that line
# when the value is empty, so leaving this blank stops the proxy from starting
# at all with "wrong argument count or unexpected line ending after 'tls'". That
# error names the Caddyfile, not this setting.
EMAIL=


### DDNS VARIABLES ###

# These variables are only necessary if you are using DDNS / comment them out if you don't use ddns
# Enter user id (use `id -u` to determine your user id)
PUID=
# Enter group id (use `id -g` to determine your group id)
PGID=


### COUNTRY BLOCKING VARIABLES ###

# Put any countries you want to block here using their ISO 3166-1 alpha-2 code (https://en.wikipedia.org/wiki/ISO_3166-1_alpha-2)
# Default is China (CN), Hong Kong (HK), and Australia (AU) because gcloud free tier charges egress to those countries
# Data is pulled from www.ipdeny.com
COUNTRIES=CN HK AU

# How often to update the ip block list - default is daily at midnight; see https://en.wikipedia.org/wiki/Cron#CRON_expression
COUNTRYBLOCK_SCHEDULE=0 0 * * *


### WATCHTOWER VARIABLES ###

# How often should watchtower check for updated container images? Default is every Sunday at 3am
#
# watchtower is opt-in: docker-compose.yml gates it behind a compose profile, so
# this setting does nothing unless you enable that profile.
WATCHTOWER_SCHEDULE=0 0 3 ? * 0


### STATUS CHECKS ###

# Once a week the backup container asks two questions that otherwise fail
# silently: is this host's Container-Optimized OS milestone still supported,
# and has a backup actually run recently? If either answer is bad it e-mails
# you using the SMTP settings above, and repeats only when the situation
# changes rather than every week.
#
# Cron expression, or "disabled" to turn the check off entirely.
CHECK_SCHEDULE=0 6 * * 1

# Alert when the newest backup is older than this many days. Eight days leaves
# slack for the daily BACKUP_SCHEDULE above to miss a run or two.
BACKUP_MAX_AGE_DAYS=8

# Send mail only when a backup fails. Without this every run reports, which
# trains you to ignore the mail that matters. Requires BACKUP_EMAIL_NOTIFY.
#BACKUP_EMAIL_NOTIFY_ON_FAILURE_ONLY=true


### STARTUP ###

# Who starts the containers at boot.
#
# Leave this unset and Docker starts the stack itself, which on Container-
# Optimized OS happens about twenty seconds before cloud-init mounts the data
# disk. Containers created in that window bind an empty directory on the boot
# disk: the ones that mount a file fail outright, and the ones that mount a
# directory come up serving nothing, without an error anywhere.
#
# Set it to "no" and the daemon leaves the stack alone. bwgc.service starts it
# once the disk is mounted, and bwgc-supervise.timer restarts anything that
# stops later.
#
# Set it to "no" on any deployment whose vault lives on a data disk and whose
# instance carries the bwgc cloud-config. That is every install built from the
# current Installation page, and every one migrate-to-data-disk.sh has touched;
# that script sets it for you. Leave it unset if there is no data disk, because
# nothing else would start the stack.
#BWGC_RESTART_POLICY=no
